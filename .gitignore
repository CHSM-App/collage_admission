# Environment config (contains URLs — copy from .env.example)
.env

# Dependencies
node_modules/

# E2E generated artifacts (auth tokens, test reports, screenshots, videos)
e2e/auth-states/
e2e/report/
test-results/
playwright-report/

# Lock file (generated, managed per-environment)
package-lock.json

# Uploaded student documents (user data, served via authenticated route)
BackEnd/uploads/

# Frontend build output — CI builds the SPA into the backend web root (emptyOutDir
# wipes and regenerates BackEnd/public), so it is never committed to main.
FrontEnd/dist/
BackEnd/public/
